# ==============================================================================
# BEWT-CovExt v2.0 — Canonical Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the repository root:
#    cp .env.example .env
# 2. Verify all values match the authorized Google Cloud runner infrastructure.
# 3. DO NOT commit `.env` to Git (it is ignored by .gitignore).
#
# SECURITY WARNING:
# - NEVER put API keys, passwords, tokens, or SSH private keys into this file.
# - Gemini API keys belong exclusively in: experiments/expresscart/.env
# - Google Cloud credentials use gcloud CLI auth store; SSH keys use ~/.ssh/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (GCP) Project & Account
# ------------------------------------------------------------------------------
# Authorized GCP project hosting the designated runner VM
BEWT_GCP_PROJECT_ID=gen-lang-client-0311012609
BEWT_GCP_PROJECT_NAME=Mina
BEWT_GCP_ACCOUNT=longgiango511@gmail.com
BEWT_GCP_REGION=asia-southeast1
BEWT_GCP_ZONE=asia-southeast1-a

# ------------------------------------------------------------------------------
# 2. Google Cloud VM Instance Configuration (Pinned Identity)
# ------------------------------------------------------------------------------
# The runner instance name and immutable instance ID.
# Any mismatch triggers immediate fail-closed execution abort.
BEWT_GCP_VM_NAME=bewt-covext-runner
BEWT_GCP_INSTANCE_ID=3042402845209891905
BEWT_GCP_MACHINE_TYPE=c4d-highmem-8
BEWT_GCP_REMOTE_USER=runner
BEWT_GCP_REMOTE_REPO=/home/runner/BEWT-CovExt

# ------------------------------------------------------------------------------
# 3. Execution & Docker Runtime Constraints (Safety Enforcement)
# ------------------------------------------------------------------------------
# Docker is strictly forbidden on the developer workstation.
# All Docker containers must execute ONLY on the approved Google Cloud VM.
BEWT_RUNTIME_PROVIDER=GOOGLE_CLOUD_COMPUTE_ENGINE
BEWT_DOCKER_RUNTIME=CLOUD_ONLY
BEWT_LOCAL_DOCKER_ALLOWED=false

# ------------------------------------------------------------------------------
# 4. Budget & Execution Bounds
# ------------------------------------------------------------------------------
# Authorized budget mode for BEWT-CovExt research on this VM.
# Max run duration is pinned to 21600 seconds (6 hours) with automatic STOP.
BEWT_CLOUD_BUDGET_MODE=UNLIMITED_USER_AUTHORIZED
BEWT_GCP_EXPECTED_MAX_RUN_DURATION_SECONDS=21600
BEWT_GCP_EXPECTED_TERMINATION_ACTION=STOP

# ------------------------------------------------------------------------------
# 5. VM Automation Policies (Safety Flags)
# ------------------------------------------------------------------------------
# Autonomous agents are NOT permitted to automatically create, start, or extend
# VMs without explicit human authorization.
BEWT_GCP_AUTO_CREATE_VM=false
BEWT_GCP_AUTO_START_VM=false
BEWT_GCP_AUTO_EXTEND_VM=false

# Required for the ExpressCart disposable admin fixture and active admin login.
BEWT_ADMIN_EMAIL=
BEWT_ADMIN_PASSWORD=

# Absolute executable paths for the G0 runner. Set these on Windows; on POSIX
# the runner may resolve an unset value from a validated absolute PATH entry.
BEWT_DOCKER_CLI_PATH=
BEWT_MAVEN_CLI_PATH=
BEWT_GIT_CLI_PATH=
