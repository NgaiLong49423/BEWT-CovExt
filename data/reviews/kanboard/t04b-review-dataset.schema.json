{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NgaiLong49423/BEWT-CovExt/blob/main/data/reviews/kanboard/t04b-review-dataset.schema.json",
  "title": "T04-B Kanboard static candidate review dataset",
  "type": "object",
  "required": ["schemaVersion", "application", "screeningMethod", "semanticReviewStatus", "screeningCounts", "sourcePins", "candidateCount", "baselineCaseCount", "pairCount", "candidates", "pairwiseComparisons", "evidenceProvenanceIndex", "globalAcceptance"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "application": {"const": "Kanboard"},
    "screeningMethod": {"const": "RULE_BASED_SCREENING"},
    "semanticReviewStatus": {"const": "PENDING_INDEPENDENT_REVIEW"},
    "screeningCounts": {"type": "object", "required": ["NO_DIRECT_OVERLAP_FLAGGED", "PARTIAL_SEMANTIC_OVERLAP"], "properties": {"NO_DIRECT_OVERLAP_FLAGGED": {"type": "integer", "minimum": 0}, "PARTIAL_SEMANTIC_OVERLAP": {"type": "integer", "minimum": 0}}},
    "sourcePins": {"type": "object", "required": ["bewtCommit", "kanboardCommit", "acceptedInventorySha256", "gapCandidatesSha256"], "properties": {"bewtCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "kanboardCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "acceptedInventorySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "gapCandidatesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": true},
    "candidateCount": {"const": 5}, "baselineCaseCount": {"const": 30}, "pairCount": {"const": 150},
    "candidates": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["id", "status", "reviewDecision", "technicalRecommendation", "sourceEvidence", "technicalReview", "oracleAssessment", "fixtureAssessment", "rubricAssessment", "humanDecision", "stages", "qualificationStages"], "properties": {"id": {"type": "string"}, "status": {"const": "PROPOSED"}, "reviewDecision": {"const": "PENDING"}, "technicalRecommendation": {"enum": ["RECOMMEND_ACCEPT", "RECOMMEND_REVISE", "RECOMMEND_REJECT", "INSUFFICIENT_EVIDENCE"]}, "sourceEvidence": {"type": "array", "minItems": 1}, "technicalReview": {"type": "object", "required": ["sourceEvidence", "baselineComparisonCaseIds", "oracleReview", "knownRisks", "unresolvedQuestions", "proposedDecision", "decisionRationale", "implementationConditions", "reviewerEvidence"]}, "oracleAssessment": {"type": "object", "required": ["proposedOracle", "entityIdentityRequired", "postReloadRequired", "runtimeStatus"], "properties": {"runtimeStatus": {"const": "NOT_RUN"}}}, "fixtureAssessment": {"type": "object", "required": ["fixture", "reset", "cleanup", "executionStatus"], "properties": {"executionStatus": {"const": "NOT_RUN"}}}, "rubricAssessment": {"type": "object", "required": ["sourceValidity", "behavioralNovelty", "oracleClarity", "fixtureFeasibility", "uiAutomationFeasibility", "isolationAndCleanup", "historicalOverlap", "evidenceSufficiency"]}, "humanDecision": {"type": "object", "required": ["reviewerIdentity", "decisionDate", "reviewedCommitSha", "decision", "rationale", "oracleConfirmation", "noveltyAssessment", "conditionsForImplementation", "reviewerEvidence"], "properties": {"decision": {"type": "null"}, "reviewerIdentity": {"type": "null"}, "decisionDate": {"type": "null"}, "reviewedCommitSha": {"type": "null"}, "rationale": {"type": "null"}, "oracleConfirmation": {"type": "null"}, "noveltyAssessment": {"type": "null"}, "conditionsForImplementation": {"type": "null"}, "reviewerEvidence": {"type": "null"}}}, "stages": {"type": "object", "properties": {"g1Ready": {"const": false}}}, "qualificationStages": {"type": "object", "required": ["staticSourceVerification", "engineeringReview", "humanReview", "humanReviewComplete", "g1ReadyForTeamLeadAcceptance", "overallG1Qualification"], "properties": {"staticSourceVerification": {"const": "STATIC_SOURCE_VERIFIED"}, "engineeringReview": {"const": "ENGINEERING_REVIEW_COMPLETE"}, "humanReview": {"const": "HUMAN_REVIEW_PENDING"}, "humanReviewComplete": {"const": false}, "g1ReadyForTeamLeadAcceptance": {"const": false}, "overallG1Qualification": {"const": "NOT_VERIFIED"}}}}}},
    "pairwiseComparisons": {"type": "array", "minItems": 150, "maxItems": 150, "items": {"type": "object", "required": ["candidateId", "baselineCaseId", "baselineAction", "baselineOracle", "baselineJavaAssertions", "classification", "screeningMethod", "screeningRuleId", "semanticReviewStatus", "humanNoveltyDecision", "rationale", "evidence"], "properties": {"classification": {"enum": ["NO_DIRECT_OVERLAP_FLAGGED", "PARTIAL_SEMANTIC_OVERLAP", "DUPLICATE_BEHAVIOR", "INSUFFICIENT_EVIDENCE"]}, "screeningMethod": {"const": "RULE_BASED_SCREENING"}, "semanticReviewStatus": {"const": "PENDING_INDEPENDENT_REVIEW"}, "humanNoveltyDecision": {"type": "null"}}}},
    "evidenceProvenanceIndex": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "path", "line", "commit", "sha256", "permalink"], "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "permalink": {"type": "string", "format": "uri"}}}},
    "riskRegister": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["candidateId", "riskId", "risk", "status", "mitigation"]}},
    "globalAcceptance": {"type": "object", "properties": {"g1": {"const": "NOT_VERIFIED"}, "humanReviewComplete": {"const": false}}}
  },
  "additionalProperties": true
}
