{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NgaiLong49423/BEWT-CovExt/blob/main/data/reviews/kanboard/t04b-review-dataset.schema.json",
  "title": "T04-B Kanboard static candidate review dataset",
  "type": "object",
  "required": ["schemaVersion", "application", "sourcePins", "candidateCount", "baselineCaseCount", "pairCount", "candidates", "pairwiseComparisons", "globalAcceptance"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "application": {"const": "Kanboard"},
    "sourcePins": {"type": "object", "required": ["bewtCommit", "kanboardCommit", "acceptedInventorySha256", "gapCandidatesSha256"], "properties": {"bewtCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "kanboardCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "acceptedInventorySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "gapCandidatesSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": true},
    "candidateCount": {"const": 5}, "baselineCaseCount": {"const": 30}, "pairCount": {"const": 150},
    "candidates": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["id", "status", "reviewDecision", "technicalRecommendation", "sourceEvidence", "humanDecision", "stages"], "properties": {"id": {"type": "string"}, "status": {"const": "PROPOSED"}, "reviewDecision": {"const": "PENDING"}, "sourceEvidence": {"type": "array", "minItems": 1}, "humanDecision": {"type": "object", "required": ["reviewerIdentity", "decisionDate", "reviewedCommitSha", "decision", "rationale", "oracleConfirmation", "noveltyAssessment"], "properties": {"decision": {"type": "null"}, "reviewerIdentity": {"type": "null"}, "decisionDate": {"type": "null"}, "reviewedCommitSha": {"type": "null"}, "rationale": {"type": "null"}, "oracleConfirmation": {"type": "null"}, "noveltyAssessment": {"type": "null"}}}, "stages": {"type": "object", "properties": {"g1Ready": {"const": false}}}}}},
    "pairwiseComparisons": {"type": "array", "minItems": 150, "maxItems": 150, "items": {"type": "object", "required": ["candidateId", "baselineCaseId", "baselineAction", "baselineOracle", "baselineJavaAssertions", "classification", "rationale", "evidence"], "properties": {"classification": {"enum": ["DISTINCT_BEHAVIOR_SUPPORTED", "PARTIAL_SEMANTIC_OVERLAP", "DUPLICATE_BEHAVIOR", "INSUFFICIENT_EVIDENCE"]}}}},
    "globalAcceptance": {"type": "object", "properties": {"g1": {"const": "NOT_VERIFIED"}, "humanReviewComplete": {"const": false}}}
  },
  "additionalProperties": true
}
