{
  "services": {
    "app": {
      "image": "bewt-covext/expresscart:1.1.19-b31302f",
      "environment": {
        "NODE_ENV": "production",
        "PORT": "1111",
        "NODE_PATH": "/var/expressCart",
        "databaseConnectionString": "mongodb://mongo:27017/expresscart_experiment"
      },
      "ports": [
        "127.0.0.1::1111"
      ],
      "depends_on": {
        "mongo": {
          "condition": "service_healthy"
        }
      },
      "restart": "no"
    },
    "mongo": {
      "image": "mongo:4.4.29",
      "command": [
        "mongod",
        "--bind_ip_all"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mongo",
          "--quiet",
          "--eval",
          "db.adminCommand('ping').ok"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      },
      "restart": "no"
    }
  }
}